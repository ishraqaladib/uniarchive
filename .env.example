PORT=3000
APP_URL=http://localhost:3000
# sqlite needs no database server. Switch to mysql for the SRS deployment stack.
DB_CLIENT=sqlite
DATA_DIR=.data
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=uniarchive
MYSQL_USER=uniarchive
MYSQL_PASSWORD=change-this-database-password
# Set a unique random secret of at least 32 characters in production.
JWT_SECRET=
# Comma-separated university email domains. Blank accepts .edu, .edu.xx, .ac.xx.
UNIVERSITY_DOMAINS=
# Without SMTP, development messages are written to .data/mail (npm run mail).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=UniArchive <noreply@example.edu>
SUPPORT_EMAIL=
# Use HTTPS and NODE_ENV=production for deployment.
NODE_ENV=development
TRUST_PROXY=0
# Only used by the optional local Docker Compose MySQL service:
MYSQL_ROOT_PASSWORD=change-this-root-password

# PDF storage: local or google-drive. Existing local PDFs keep their provider.
STORAGE_PROVIDER=local
# Server-only Google OAuth secrets; never use VITE_ prefixes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
# Optional private JSON path, especially for a mounted production secret file.
# GOOGLE_DRIVE_CREDENTIALS_FILE=/absolute/private/path/google-drive-client.json
